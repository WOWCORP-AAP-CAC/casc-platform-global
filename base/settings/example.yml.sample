---
# Example controller settings — rename to .yml to activate.
# This file belongs in base/settings/ and applies to ALL environments.
# For environment-specific overrides, place a .yml file in <env>/settings/.
# Full field reference: https://github.com/WOWCORP-AAP-CAC/aap-casc-engine/blob/main/docs/RESOURCE_CATALOG.md#controller_settings
# Engine accepts the collection mapping form only (not the list form).
controller_settings:
  settings:
    TOWER_URL_BASE: "https://aap.example.com"
